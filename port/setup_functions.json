   "strings": {
    "00bf": "misc.exe",
    "0362": "F117A works best if played from a hard disk.",
    "038f": "It can be played from 1.2 Mb floppies,",
    "03b6": "but we recommend you use backup disks.",
    "03dd": "The game CANNOT be played from 720Kb floppy disks;",
    "0410": "it must be installed on to your hard drive.",
    "043c": "Instructions for game installation can be found in the Technical Supplement.",
    "0489": "You cannot play F117A off of 720K floppy disks!!",
    "0536": "         Move joystick to upper left corner, then press fire button 1 ",
    "057d": "       Now move joystick to lower right corner, then press fire button 2 ",
    "05c7": "Mgraphic.exe",
    "0624": "                        1) IBM Sound                                          ",
    "0673": "                        2) Ad Lib Sound Board                                 ",
    "06c2": "                        3) Roland Sound Board                                 ",
    "0711": "                        4) No Sound                                           ",
    "0760": "One Moment Please..."
